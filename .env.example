# Newspaper server settings. They are read only by the newspaper's SSR server and are never
# sent to browsers, so they must not use the VITE_ prefix. Copy to .env.local for local
# development. Every value is optional locally; paths are relative to the repository root.

# Content folder (stories, editions, polls, media). Default: content
HERALD_CONTENT_DIR=

# Public origin of the R2 bucket that holds uploads, e.g. https://media.news.kmla.online
# Empty: uploads under /media are served by the newspaper itself.
HERALD_MEDIA_BASE_URL=

# Vote storage file. Default: .data/votes.json
HERALD_VOTES_FILE=
